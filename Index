        function generateNewEmoji() {
            // Switch views if this is the first generation
            if (history.length === 0) {
                initialView.classList.add('hidden');
                generatorView.classList.remove('hidden');
                generatorView.classList.add('flex');
            }

            // Determine the category to avoid (the one currently being viewed, if any)
            let avoidCategory = null;
            if (currentIndex >= 0 && currentIndex < history.length) {
                avoidCategory = history[currentIndex].category;
            }

            // Get all available categories
            const allCategories = Object.keys(emojiDictionary);
            
            // Filter out the avoided category and any categories where all emojis have been used
            let availableCategories = allCategories.filter(cat => {
                if (cat === avoidCategory) return false;
                return emojiDictionary[cat].some(emoji => !usedEmojis.has(emoji));
            });

            // If we run out of emojis, reset the session pool gracefully
            if (availableCategories.length === 0) {
                usedEmojis.clear();
                availableCategories = allCategories.filter(cat => cat !== avoidCategory);
            }
            
            // Select random category
            const randomCategory = availableCategories[Math.floor(Math.random() * availableCategories.length)];
            
            // Filter to only unused emojis in this category
            const unusedEmojisInCategory = emojiDictionary[randomCategory].filter(emoji => !usedEmojis.has(emoji));
            
            // Select random unused emoji
            const randomEmoji = unusedEmojisInCategory[Math.floor(Math.random() * unusedEmojisInCategory.length)];

            // Mark as used
            usedEmojis.add(randomEmoji);

            // Create new record
            const newRecord = {
                emoji: randomEmoji,
                category: randomCategory
            };

            // If we've gone back in time and generate a new one, we append it to the absolute end of the history.
            // This preserves the full timeline while allowing new generation.
            history.push(newRecord);
            
            // Jump to the newly created emoji at the end of the history
            currentIndex = history.length - 1;
            
            updateUI();
        }

        function goPrev() {
            if (currentIndex > 0) {
                currentIndex--;
                updateUI();
            }
        }

        function goNext() {
            if (currentIndex < history.length - 1) {
                currentIndex++;
                updateUI();
            }
        }

        function updateUI() {
            const currentItem = history[currentIndex];

            // Trigger reflow to restart CSS animation
            emojiDisplay.classList.remove('animate-pop');
            void emojiDisplay.offsetWidth; // Force DOM reflow
            
            // Update content
            emojiDisplay.textContent = currentItem.emoji;
            
            // Add animation
            emojiDisplay.classList.add('animate-pop');

            // Update button states
            btnPrev.disabled = (currentIndex === 0);
            btnNext.disabled = (currentIndex === history.length - 1);
        }
    </script>
</body>
</html>
